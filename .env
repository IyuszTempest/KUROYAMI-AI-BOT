BOT_NAME=Kuroyami

# Gemini API
GEMINI_API_KEY=GANTI APIKEYNYA
GEMINI_MODEL=gemini-3.5-flash-lite

# Perilaku bot
GROUP_ONLY=true
HISTORY_MESSAGES=8
MAX_OUTPUT_TOKENS=800
COOLDOWN_SECONDS=7

# Pencarian berita Google News RSS
NEWS_SEARCH_ENABLED=true
NEWS_LANGUAGE=id
NEWS_COUNTRY=ID
NEWS_MAX_RESULTS=8
NEWS_MAX_AGE_DAYS=7
NEWS_ALLOWED_DOMAINS=
NEWS_BLOCKED_DOMAINS=
NEWS_TIMEOUT_MS=10000

# Opsional: API pencarian tambahan
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=